  "findings": [
    {
      "category": "syntactic",
      "criterion": "reader_in_third_person",
      "justification": "The reader is named in the third person (“lessee”) and given an obligation or a permission (“shall”). The Federal Plain Language Guidelines (2011, p. 30) recommend speaking to the reader as “you”, which says plainly who must act (ISO 24495-1, 5.3.3). Only the author knows whether the document's reader is the person named here.",
      "meta": {
        "deontic": "shall",
        "readerNoun": "lessee",
