exports[`en-US — full Diagnostic snapshots > structure 1`] = `
{
  "findings": [
    {
      "category": "structural",
      "criterion": "heading_level_skip",
      "justification": "This heading jumps from level 1 to 4 without passing through 2. Skipped levels break reading by structure (table of contents, scanning, screen readers). Adjust this heading's level or add an intermediate one; the tool does not reorganize the hierarchy for you.",
      "meta": {
        "level": 4,
        "prevLevel": 1,
      },
      "normativeReference": {
        "section": "5.2.4",
        "standard": "ISO 24495-1",
      },
      "principleGroup": "findable",
      "requiresHuman": true,
      "severity": "warning",
