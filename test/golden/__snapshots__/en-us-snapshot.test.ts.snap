exports[`en-US — full Diagnostic snapshots > passive 1`] = `
{
  "findings": [
    {
      "category": "syntactic",
      "criterion": "passive_voice",
      "justification": "Passive voice with the agent after the verb, introduced by “by”. The sentence says who acts, but only after the action; making that agent the subject shows who does what (ISO 24495-1, 5.3.3). Whether to change it is the author's decision.",
      "meta": {
        "agentEnd": 45,
        "agentMarkerEnd": 32,
        "agentMarkerStart": 30,
        "agentTruncated": false,
        "form": "past",
        "hasAgent": true,
        "participleEnd": 29,
        "participleStart": 21,
      },
      "normativeReference": {
        "section": "5.3.3",
        "standard": "ISO 24495-1",
      },
      "principleGroup": "understandable",
      "requiresHuman": false,
      "severity": "warning",
      "source": "iso-24495-1",
      "span": {
        "end": 45,
        "start": 17,
        "text": "was approved by the director",
      },
    },
    {
      "category": "syntactic",
