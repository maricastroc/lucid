      "span": {
        "end": 28,
        "start": 17,
        "text": "Eligibility",
      },
    },
    {
      "category": "structural",
      "criterion": "single_item_list",
      "justification": "List with a single item. A list exists to separate and compare several items; with one, it helps no one find anything and suggests either that an item is missing or that the content belongs in running text. This is structural hygiene (a weak signal, with no direct guideline in the standard): completing the list or folding it into the prose is the author's decision.",
      "meta": {
        "ordered": false,
      },
      "principleGroup": "findable",
      "requiresHuman": true,
      "severity": "info",
      "source": "structural-heuristic",
