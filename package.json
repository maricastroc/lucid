{
  "name": "lucid",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic Plain Language auditor for Brazilian Portuguese, built on ISO 24495-1. The engine judges but never writes; an LLM may propose but never approves.",
  "keywords": [
    "plain-language",
    "iso-24495-1",
    "linter",
    "deterministic",
    "portuguese",
    "pt-br",
    "accessibility",
    "govtech",
    "static-analysis",
    "llm-verification",
    "abnt"
  ],
  "license": "MIT",
  "author": "Mariana Castro",
  "homepage": "https://lucid.marianacastro.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/maricastroc/lucid.git"
  },
  "bugs": {
    "url": "https://github.com/maricastroc/lucid/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "EVAL_ARTIFACT=1 vitest run test/eval/artifact.emit.test.ts",
    "test:watch": "vitest",
    "depcheck": "depcruise src scripts --config .dependency-cruiser.cjs",
    "mutation": "stryker run",
    "mutation:core": "stryker run --mutate \"src/lucid/**/*.ts\"",
    "mutation:passes": "stryker run --mutate \"src/locales/pt-BR/passes/**/*.ts\"",
    "mutation:report": "stryker run --mutate \"src/report/**/*.ts\"",
    "build:cli": "esbuild src/cli/bin.ts --bundle --platform=node --format=esm --target=node20 --external:mammoth --outfile=dist/cli/lucid.mjs --banner:js=\"#!/usr/bin/env node\"",
    "lucid": "npm run build:cli --silent && node dist/cli/lucid.mjs",
    "corpus:collect": "node scripts/corpus/run.mjs collect",
    "corpus:extract": "node scripts/corpus/run.mjs extract",
    "corpus:segment": "node scripts/corpus/run.mjs segment",
    "corpus:label": "node --env-file-if-exists=.env scripts/corpus/run.mjs label",
    "corpus:reconcile": "node scripts/corpus/run.mjs reconcile",
    "corpus:review": "node scripts/corpus/run.mjs review",
    "corpus:measure": "vitest run test/eval/corpus-measure.test.ts",
    "measure:rewrite-context": "CONTEXT_MEASURE=1 vitest run test/eval/rewrite-context.test.ts",
    "ab:plan": "AB_PLAN=1 vitest run test/eval/rewrite-ab/ab.test.ts",
    "ab:report": "AB_REPORT=1 vitest run test/eval/rewrite-ab/ab.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pdf:worker": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "npm run pdf:worker",
    "predev": "npm run pdf:worker"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.8",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.4",
    "jszip": "^3.10.1",
    "lucide-react": "^1.26.0",
    "mammoth": "^1.12.0",
    "next": "16.2.10",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "bin": {
    "lucid": "./dist/cli/lucid.mjs"
  }
}
