{
  "name": "lucid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "EVAL_ARTIFACT=1 vitest run test/eval/artifact.emit.test.ts",
    "test:watch": "vitest",
    "depcheck": "depcruise src --config .dependency-cruiser.cjs",
    "mutation": "stryker run",
    "mutation:core": "stryker run --mutate \"src/lucid/**/*.ts\"",
    "mutation:passes": "stryker run --mutate \"src/locales/pt-BR/passes/**/*.ts\"",
    "mutation:report": "stryker run --mutate \"src/report/**/*.ts\"",
    "build:cli": "esbuild src/cli/bin.ts --bundle --platform=node --format=esm --target=node20 --external:mammoth --outfile=dist/cli/lucid.mjs --banner:js=\"#!/usr/bin/env node\"",
    "lucid": "npm run build:cli --silent && node dist/cli/lucid.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.8",
    "@radix-ui/react-select": "^2.3.4",
    "lucide-react": "^1.26.0",
    "mammoth": "^1.12.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "bin": {
    "lucid": "./dist/cli/lucid.mjs"
  }
}
